# Copia este archivo como .env y cambia los valores marcados.

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR

# 1 solo para desarrollo (muestra errores detallados). En uso real, 0.
DJANGO_DEBUG=0

# Nombres o IPs con los que se accede al servidor, separados por comas.
# "*" acepta cualquiera (cómodo en una red local de pruebas).
DJANGO_ALLOWED_HOSTS=*

# Base de datos PostgreSQL
POSTGRES_DB=transporte
POSTGRES_USER=transporte
POSTGRES_PASSWORD=CAMBIAR

# Solo si ejecutas Django sin Docker (con Docker se ignoran: se usa el servicio "db")
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Puerto en el que se publica el servidor al usar Docker
WEB_PORT=8000
