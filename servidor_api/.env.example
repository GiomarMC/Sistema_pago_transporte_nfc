# Copia este archivo como .env y cambia los valores marcados.

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR

# 1 solo para desarrollo (muestra errores detallados). En uso real, 0.
DJANGO_DEBUG=0

# Nombres o IPs con los que se accede al servidor, separados por comas.
# "*" acepta cualquiera (cómodo en una red local de pruebas).
DJANGO_ALLOWED_HOSTS=*

# Base de datos PostgreSQL
POSTGRES_DB=transporte
POSTGRES_USER=transporte
POSTGRES_PASSWORD=CAMBIAR

# Solo si ejecutas Django sin Docker (con Docker se ignoran: se usa el servicio "db")
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Clave privada ECDSA P-256 del servidor para la sincronización v2 (firma las
# listas, acuses y tarifas que reciben los validadores). Se genera con:
#   python manage.py generar_clave_listas
# que la imprime ya en una línea (los saltos del PEM como \n) y escribe la
# clave pública en pantalla_esp32/src/validador/clave_servidor.h. Déjala vacía
# hasta entonces y no la compartas: quien la tenga puede firmar listas falsas.
LISTAS_CLAVE_PRIVADA=

# Puerto en el que se publica el servidor al usar Docker
WEB_PORT=8000

# --- Solo para el despliegue en internet (docker-compose.prod.yml) ---
# Dominio(s) que apuntan a la IP pública del servidor, separados por ", "
# (p. ej. "subepe.app, www.subepe.app"); Caddy saca un certificado para cada
# uno. Ponlos también en DJANGO_ALLOWED_HOSTS, separados solo por comas.
DOMINIO=
# 1 cuando se entra por HTTPS a través de Caddy
DJANGO_HTTPS=0
