# Proxy con HTTPS automático (certificado de Let's Encrypt) para el servidor en
# internet. Lo usa docker-compose.prod.yml; DOMINIO y DOMINIO_CLIENTE se definen en
# .env. Ambos van a Django, que elige las rutas según el host (config/middleware.py).
{
	# Solo Let's Encrypt (sin recurrir a ZeroSSL si falla): los validadores ESP32
	# confían únicamente en sus raíces (pantalla_esp32/src/validador/raices_tls.h)
	cert_issuer acme
}

{$DOMINIO}, {$DOMINIO_CLIENTE} {
	encode gzip
	reverse_proxy web:8000
}
