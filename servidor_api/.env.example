# Copia este archivo como .env y cambia los valores marcados.

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR

# 1 solo para desarrollo (muestra errores detallados). En uso real, 0.
DJANGO_DEBUG=0

# Nombres o IPs con los que se accede al servidor, separados por comas.
# "*" acepta cualquiera (cómodo en una red local de pruebas).
DJANGO_ALLOWED_HOSTS=*

# Dominio del portal de clientes (empieza con "mi."). En local: mi.localhost
# (se abre en http://mi.localhost:8000). En internet: mi.subepe.app
DOMINIO_CLIENTE=mi.localhost

# Base de datos PostgreSQL
POSTGRES_DB=transporte
POSTGRES_USER=transporte
POSTGRES_PASSWORD=CAMBIAR

# Solo si ejecutas Django sin Docker (con Docker se ignoran: se usa el servicio "db")
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Pagos en línea: pasarela activa ("simulada"; "falsa" solo en tests) y secreto
# con el que se firman sus webhooks. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAGOS_PASARELA=simulada
PAGOS_SECRETO_WEBHOOK=CAMBIAR

# Clave privada ECDSA P-256 del servidor para la sincronización v2 (firma las
# listas, acuses y tarifas que reciben los validadores). Se genera con:
#   python manage.py generar_clave_listas
# que la imprime ya en una línea (los saltos del PEM como \n) y escribe la
# clave pública en pantalla_esp32/src/validador/clave_servidor.h. Déjala vacía
# hasta entonces y no la compartas: quien la tenga puede firmar listas falsas.
LISTAS_CLAVE_PRIVADA=

# Contraseña del usuario "puente" de Mosquitto (el broker MQTT de la
# sincronización v2). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Las de los validadores no van aquí: se generan con
#   python manage.py clave_validador <n.º> --mqtt
MQTT_PUENTE_CLAVE=

# Claves de la verificación SUN de la NTAG 424 DNA (página /t, M1-08). Vacías =
# la página responde «Verificación no disponible». SUN_K3 es la K3 común de las
# tarjetas (32 hex); SUN_K4_MAESTRAS, las maestras de K4 por versión:
#   SUN_K4_MAESTRAS=1:<32 hex>,2:<32 hex>
# Deben ser las mismas que se grabaron al personalizar las tarjetas. No las
# compartas: con K4 se pueden fabricar enlaces que la página da por auténticos.
SUN_K3=
SUN_K4_MAESTRAS=

# Puerto en el que se publica el servidor al usar Docker
WEB_PORT=8000

# Correo electrónico con Gmail (SMTP, STARTTLS). Requiere verificación en dos pasos y una
# contraseña de aplicación de 16 caracteres (ver README, "Correo electrónico (Gmail)").
# Si se dejan vacías, los correos solo se muestran en la consola (desarrollo).
CORREO_USUARIO=
CORREO_CLAVE_APP=

# --- Solo para el despliegue en internet (docker-compose.prod.yml) ---
# Dominio(s) que apuntan a la IP pública del servidor, separados por ", "
# (p. ej. "subepe.app, www.subepe.app"); Caddy saca un certificado para cada
# uno. Ponlos también en DJANGO_ALLOWED_HOSTS, separados solo por comas.
DOMINIO=
DOMINIO_CLIENTE=mi.localhost
# 1 cuando se entra por HTTPS a través de Caddy
DJANGO_HTTPS=0
